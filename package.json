{
  "name": "swanco",
  "version": "4.0.7",
  "description": "Swagger code generation for Angular",
  "author": "Alexander Semenov",
  "license": "MIT",
  "engines": {
    "node": ">=10.12.0"
  },
  "scripts": {
    "start": "tsc -w",
    "build": "tsc",
    "lint": "eslint ./src",
    "test": "jest --config jest.config.json",
    "doc": "typedoc './src/!(*.test).ts' --out doc",
    "release": "standard-version",
    "generate": "node ./dist/cli -o tmp -i"
  },
  "keywords": [
    "swagger",
    "angular",
    "generator"
  ],
  "files": [
    "dist/*.js",
    "dist/index.d.ts",
    "templates"
  ],
  "bin": "dist/cli.js",
  "main": "dist/index.js",
  "homepage": "https://github.com/semalexp/swanco#readme",
  "bugs": {
    "url": "https://github.com/semalexp/swanco/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/semalexp/swanco.git"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "handlebars": "^4.7.10",
    "lodash.camelcase": "^4.3.0",
    "lodash.groupby": "^4.6.0",
    "lodash.isequal": "^4.5.0",
    "lodash.kebabcase": "^4.1.1",
    "lodash.orderby": "^4.18.0",
    "lodash.uniqby": "^4.7.0",
    "lodash.upperfirst": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/lodash.camelcase": "^4.3.9",
    "@types/lodash.groupby": "^4.6.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/lodash.orderby": "^4.6.9",
    "@types/lodash.uniqby": "^4.7.9",
    "@types/lodash.upperfirst": "^4.3.9",
    "@types/node": "^26.6.5",
    "@types/swagger-schema-official": "^2.0.25",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.0.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
